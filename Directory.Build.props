<Project>
  <!-- Pengaturan bersama untuk semua project di solution MyUninstaller. -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>2.0.0</Version>
    <!-- Versi produk tetap "1.0.0" (tanpa "+hash commit" yang ditambahkan otomatis di repo git). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>My Uninstaller!</Company>
    <Product>My Uninstaller!</Product>
    <Copyright>Pemakaian pribadi</Copyright>
    <NeutralLanguage>id-ID</NeutralLanguage>
    <SatelliteResourceLanguages>id</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Rilis tanpa berkas .pdb terpisah (semua project, supaya tidak ikut ke folder publish). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Target Windows yang sama untuk project yang memakai API Windows. -->
  <PropertyGroup>
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
  </PropertyGroup>
</Project>
