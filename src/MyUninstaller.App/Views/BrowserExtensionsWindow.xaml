<local:ThemedWindow x:Class="MyUninstaller.App.Views.BrowserExtensionsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:MyUninstaller.App.Views"
                    xmlns:loc="clr-namespace:MyUninstaller.App.Localization"
                    xmlns:vm="clr-namespace:MyUninstaller.App.ViewModels"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:BrowserExtensionsViewModel}"
                    Title="{loc:Tr Extensions_Title}"
                    Width="900" Height="640" MinWidth="700" MinHeight="420"
                    ShowInTaskbar="True" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CollapsedWhenNull" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr Extensions_Title}" FontFamily="{StaticResource UiDisplayFont}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr Extensions_Subtitle}" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="380">
                <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding NoticeText}" Tag="{Binding NoticeText}" Style="{StaticResource CollapsedWhenNull}"
                           Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Refresh}" Content="{loc:Tr Refresh_Tooltip}"
                        Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Copy}" Content="{loc:Tr Extensions_CopyId}"
                        Command="{Binding CopyIdCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Folder}" Content="{loc:Tr Extensions_OpenFolder}"
                        Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                <!-- Merah, bukan tombol Enter. -->
                <Button Style="{StaticResource DangerTextButton}" Content="{loc:Tr Extensions_Remove}" Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Close}" IsCancel="True" Click="Close_Click"
                        Margin="8,0,0,0" MinWidth="80" />
            </StackPanel>
        </Grid>

        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         Padding="4" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource UiDisplayFont}" FontSize="14" FontWeight="SemiBold"
                                               Margin="10,10,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BrowserExtensionItemViewModel}">
                            <Grid ToolTip="{Binding Description}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Glyph" Style="{StaticResource GlyphText}" Text="&#xEA86;" Foreground="{DynamicResource AccentTextBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="Title" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding DetailText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Id, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{loc:Tr Extensions_Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </DockPanel>
</local:ThemedWindow>
