<local:ThemedWindow x:Class="MyUninstaller.App.Views.PortableProgramsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:MyUninstaller.App.Views"
                    xmlns:loc="clr-namespace:MyUninstaller.App.Localization"
                    xmlns:vm="clr-namespace:MyUninstaller.App.ViewModels"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:PortableProgramsViewModel}"
                    Title="{loc:Tr Portable_Title}"
                    Width="920" Height="640" MinWidth="720" MinHeight="420"
                    ShowInTaskbar="True" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CollapsedWhenNull" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr Portable_Title}" FontFamily="{StaticResource UiDisplayFont}" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr Portable_Subtitle}" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="330">
                <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding NoticeText}" Tag="{Binding NoticeText}" Style="{StaticResource CollapsedWhenNull}"
                           Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Search}" Content="{loc:Tr Portable_Scan}"
                        Command="{Binding ScanCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Folder}" Content="{loc:Tr Portable_ScanFolder}"
                        Command="{Binding ScanFolderCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Stop}" Content="{loc:Tr Portable_Stop}"
                        Command="{Binding StopCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Folder}" Content="{loc:Tr Extensions_OpenFolder}"
                        Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                <!-- Merah, bukan tombol Enter. -->
                <Button Style="{StaticResource DangerTextButton}" Content="{loc:Tr Portable_Remove}" Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Close}" IsCancel="True" Click="Close_Click"
                        Margin="8,0,0,0" MinWidth="80" />
            </StackPanel>
        </Grid>

        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         Padding="4" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PortableProgramItemViewModel}">
                            <Grid ToolTip="{Binding Folder}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource GlyphText}" Text="{StaticResource Glyph.Package}" Foreground="{DynamicResource AccentTextBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Folder}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DetailText}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Di AppData: bisa program yang ikut terpasang saat browsing, bisa juga komponen program lain. -->
                                    <Border Style="{StaticResource BadgeBorder}" Background="{DynamicResource BadgeRareBrush}" Margin="0,0,6,0"
                                            ToolTip="{loc:Tr Portable_AppDataTooltip}"
                                            Visibility="{Binding IsInAppData, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="{loc:Tr Portable_AppDataBadge}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeBorder}" Background="{DynamicResource BadgeRareBrush}"
                                            ToolTip="{loc:Tr Badge_Rare_Tooltip}"
                                            Visibility="{Binding IsRarelyUsed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource BadgeText}" Text="{loc:Tr Badge_Rare}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{loc:Tr Portable_Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="460" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" BorderThickness="0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="{loc:Tr Portable_Scanning}" Margin="0,10,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</local:ThemedWindow>
