<local:ThemedWindow x:Class="MyUninstaller.App.Views.HunterWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MyUninstaller.App.Views"
                    xmlns:loc="clr-namespace:MyUninstaller.App.Localization"
                    Title="{loc:Tr Hunter_Title}"
                    Width="400" SizeToContent="Height" ResizeMode="NoResize"
                    Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual">
    <StackPanel Margin="20,16,20,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ikon target: tekan, seret ke program, lepaskan. -->
            <Border x:Name="Target" Width="72" Height="72" CornerRadius="36" Cursor="Cross"
                    Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                    MouseLeftButtonDown="Target_MouseLeftButtonDown" MouseLeftButtonUp="Target_MouseLeftButtonUp"
                    LostMouseCapture="Target_LostMouseCapture">
                <TextBlock x:Name="TargetGlyph" Style="{StaticResource GlyphText}" FontSize="34" HorizontalAlignment="Center"
                           Text="{StaticResource Glyph.Target}" Foreground="{DynamicResource AccentTextBrush}" />
            </Border>

            <TextBlock Grid.Column="1" Text="{loc:Tr Hunter_Instruction}" TextWrapping="Wrap" Margin="16,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>

        <!-- Hasil -->
        <Border x:Name="ResultPanel" Margin="0,16,0,0" Padding="14,12" CornerRadius="8" Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" FontSize="{StaticResource FontSize.BodyLarge}" TextWrapping="Wrap" />
                <TextBlock x:Name="ResultDetail" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel x:Name="ResultActions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Hunter_Select}" Click="Select_Click" />
                    <Button Style="{StaticResource DangerButton}" Content="{loc:Tr Button_Uninstall}" Margin="8,0,0,0"
                            Padding="14,7" FontSize="{StaticResource FontSize.Body}" Click="Uninstall_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</local:ThemedWindow>
