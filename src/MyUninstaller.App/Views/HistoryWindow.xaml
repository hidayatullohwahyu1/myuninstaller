<local:ThemedWindow x:Class="MyUninstaller.App.Views.HistoryWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:MyUninstaller.App.Views"
                    xmlns:loc="clr-namespace:MyUninstaller.App.Localization"
                    xmlns:vm="clr-namespace:MyUninstaller.App.ViewModels"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
                    Title="{loc:Tr History_Title}"
                    Width="1000" Height="640" MinWidth="800" MinHeight="460"
                    ShowInTaskbar="True" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CollapsedWhenNull" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Lencana status sesi -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{DynamicResource BadgeNewBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRestored}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BadgeRareBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kepala -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr History_Title}" FontFamily="{StaticResource UiDisplayFont}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding QuarantineText}" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Daftar sesi -->
        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Padding="4" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistorySessionViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ModeText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusBadge}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{loc:Tr History_Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Rincian sesi -->
        <Border Grid.Row="1" Grid.Column="2" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SurfaceBrush}" Padding="16,12">
            <Grid>
                <TextBlock Text="{loc:Tr History_SelectSession}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Selected.Title}" FontFamily="{StaticResource UiDisplayFont}" FontSize="16"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding Selected.DateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Selected.ModeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Selected.StatusText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Selected.Session.Note}" Tag="{Binding Selected.Session.Note}" Style="{StaticResource CollapsedWhenNull}"
                                   Margin="0,2,0,0" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SummaryText}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding RestorableText}" Margin="0,2,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                        <TextBlock Text="{loc:Tr History_Actions}" Margin="0,12,0,4" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryActionViewModel}">
                                <Grid Margin="0,4" ToolTip="{Binding BackupPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Target}" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="{Binding Detail}" Tag="{Binding Detail}" Style="{StaticResource CollapsedWhenNull}"
                                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="Status" Grid.Column="2" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BadgeNewBrush}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRestored}" Value="True">
                                        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Tombol -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding NoticeText}" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0" MaxWidth="360" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Copy}" Content="{loc:Tr History_CopyReport}"
                        Command="{Binding CopyReportCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Folder}" Content="{loc:Tr History_OpenQuarantine}"
                        Command="{Binding OpenQuarantineCommand}" Margin="8,0,0,0" />
                <!-- Hapus permanen: merah, tidak pernah tombol Enter. -->
                <Button Style="{StaticResource DangerTextButton}" Content="{loc:Tr History_Purge}" Command="{Binding PurgeCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Tag="{StaticResource Glyph.History}" Content="{loc:Tr History_Undo}"
                        Command="{Binding UndoCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Close}" IsCancel="True" Click="Close_Click"
                        Margin="8,0,0,0" MinWidth="90" />
            </StackPanel>
        </Grid>
    </Grid>
</local:ThemedWindow>
