<local:ThemedWindow x:Class="MyUninstaller.App.Views.InstallMonitorWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:MyUninstaller.App.Views"
                    xmlns:loc="clr-namespace:MyUninstaller.App.Localization"
                    xmlns:vm="clr-namespace:MyUninstaller.App.ViewModels"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance Type=vm:InstallMonitorViewModel}"
                    Title="{loc:Tr Monitor_Title}"
                    Width="920" Height="660" MinWidth="720" MinHeight="460"
                    ShowInTaskbar="True" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CollapsedWhenNull" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,5" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr Monitor_Title}" FontFamily="{StaticResource UiDisplayFont}" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr Monitor_Subtitle}" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Langkah saat ini + tombolnya. -->
        <Border DockPanel.Dock="Top" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SurfaceBrush}" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding StepText}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" BorderThickness="0" MaxWidth="320" HorizontalAlignment="Left" Width="320"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"
                                 Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                    <Grid Margin="0,8,0,0" Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr Monitor_ProgramName}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource NameBox}" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                 Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Monitor_Start}" Command="{Binding StartCommand}"
                            Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource SecondaryButton}" Tag="{StaticResource Glyph.Folder}" Content="{loc:Tr Monitor_RunInstaller}"
                                Command="{Binding RunInstallerCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Monitor_Finish}" Command="{Binding FinishCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:Tr Monitor_Save}" Command="{Binding SaveCommand}"
                            Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Cancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding NoticeText}" Tag="{Binding NoticeText}" Style="{StaticResource CollapsedWhenNull}" MaxWidth="560"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource DangerTextButton}" Content="{loc:Tr Monitor_DeleteTrace}" Command="{Binding DeleteTraceCommand}"
                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Tr Common_Close}" IsCancel="True" Click="Close_Click"
                        Margin="8,0,0,0" MinWidth="80" />
            </StackPanel>
        </Grid>

        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <!-- Hasil pemantauan: benda baru, bisa dibatalkan centangnya. -->
                <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Padding="4"
                         Foreground="{DynamicResource TextPrimaryBrush}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource RowItem}"
                         VirtualizingPanel.IsVirtualizing="True"
                         Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TraceItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource ThemedCheckBox}" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                          Click="Item_Toggled" />
                                <TextBlock Grid.Column="1" Text="{Binding KindText}" Margin="8,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding LocationText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding LocationText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Jejak tersimpan. -->
                <Grid Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                    <ListBox ItemsSource="{Binding Traces}" SelectedItem="{Binding SelectedTrace}" Background="Transparent" BorderThickness="0"
                             Padding="4" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource RowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InstallTraceItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource GlyphText}" Text="{StaticResource Glyph.History}" Foreground="{DynamicResource AccentTextBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailText}" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{loc:Tr Monitor_NoTraces}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="480" Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTraces}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Text="{loc:Tr Monitor_InstallHint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="520" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </DockPanel>
</local:ThemedWindow>
