<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil rilis My Uninstaller! 1.0: satu berkas exe untuk Windows 10/11 64-bit.

  Keputusan (15 November 2026): framework-dependent, BUKAN self-contained seperti tertulis di PRD.
  Alasan: self-contained ±67 MB (installer ±61 MB) karena WPF tidak bisa di-trim dan proyeksi WinRT untuk
  aplikasi Store ±25 MB, jauh di atas target PRD "installer < 15 MB". Framework-dependent ±29 MB (installer ±8 MB),
  tetapi butuh .NET 10 Desktop Runtime x64; installer memeriksanya dan memberi tautan unduh bila belum ada.

  Pakai: build-rilis.ps1 di akar repo (tes → publish → installer), atau
         dotnet publish src/MyUninstaller.App -p:PublishProfile=Rilis
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Pustaka native (SQLite) ikut di dalam exe dan diekstrak otomatis saat dijalankan. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- ReadyToRun: +3 MB, tetapi jendela muncul ±1 detik lebih cepat (diukur 15 November 2026). -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
