<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema gelap. Kunci harus sama persis dengan Colors.Light.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1C21" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#202329" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#25282F" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2A2E36" />
    <SolidColorBrush x:Key="BorderBrush" Color="#373C47" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2F333C" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A2ACBA" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#646C7A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2F3440" />
    <SolidColorBrush x:Key="PressedBrush" Color="#383E4C" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1F2228" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B34" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#A8232B" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#8E1D24" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BadgeNewBrush" Color="#15803D" />
    <SolidColorBrush x:Key="BadgeRareBrush" Color="#B45309" />
    <!-- Isi berwarna (teks putih di atasnya) harus >= 4,5:1; satu merah untuk semua arti "bahaya". -->
    <SolidColorBrush x:Key="BadgeRiskBrush" Color="#C42B34" />
    <!-- Merah untuk TEKS di atas permukaan tema ini (rona sama, kecerahan disesuaikan agar >= 4,5:1). -->
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF8A92" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FBBF24" />
    <!-- Isi lencana netral (skor Ragu) dengan teks putih: 5,3:1 di kedua tema. -->
    <SolidColorBrush x:Key="NeutralBadgeBrush" Color="#646C7D" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A5160" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#646C7D" />
</ResourceDictionary>
