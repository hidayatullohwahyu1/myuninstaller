<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema terang. Kunci harus sama persis dengan Colors.Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EBF0F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE3EC" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E6EBF2" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6577" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A0A8B6" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E3EAF5" />
    <SolidColorBrush x:Key="PressedBrush" Color="#D6E0EF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#991B1B" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BadgeNewBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="BadgeRareBrush" Color="#D97706" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2CAD6" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9AA4B4" />
</ResourceDictionary>
