<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema terang. Kunci harus sama persis dengan Colors.Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EBF0F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE3EC" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E6EBF2" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6577" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A0A8B6" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E3EAF5" />
    <SolidColorBrush x:Key="PressedBrush" Color="#D6E0EF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B34" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#A8232B" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#8E1D24" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BadgeNewBrush" Color="#15803D" />
    <SolidColorBrush x:Key="BadgeRareBrush" Color="#B45309" />
    <!-- Isi berwarna (teks putih di atasnya) harus >= 4,5:1; satu merah untuk semua arti "bahaya". -->
    <SolidColorBrush x:Key="BadgeRiskBrush" Color="#C42B34" />
    <!-- Merah untuk TEKS di atas permukaan tema ini (rona sama, kecerahan disesuaikan agar >= 4,5:1). -->
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B4232C" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#166534" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#9A3412" />
    <!-- Isi lencana netral (skor Ragu) dengan teks putih: 5,3:1 di kedua tema. -->
    <SolidColorBrush x:Key="NeutralBadgeBrush" Color="#646C7D" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2CAD6" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9AA4B4" />
</ResourceDictionary>
